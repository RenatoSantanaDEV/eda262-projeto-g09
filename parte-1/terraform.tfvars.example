# A configuração entregue está em scenario.auto.tfvars e é carregada
# automaticamente. Copie este arquivo para terraform.tfvars somente se precisar
# definir overrides opcionais e revisados.

database_name_override = null
trusted_table_name     = "trusted"

# O limite de bytes por consulta está definido em scenario.auto.tfvars
# (10485760 bytes = 10 MiB, o menor valor aceito pelo provider AWS). Um valor
# definido aqui tem precedência; use nulo somente para desativar o limite.
# athena_bytes_scanned_cutoff = 10485760

extra_tags = {}
